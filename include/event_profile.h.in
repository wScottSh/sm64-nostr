#ifndef PIPELINE_EVENT_PROFILE_H
#define PIPELINE_EVENT_PROFILE_H

/*
 * GENERATED by tools/gen_event_profile.py -- DO NOT EDIT (spec #24, sub-issue
 * #26). Rendered from this template into $(BUILD_DIR)/include/event_profile.h,
 * following the same *.h.in -> $(BUILD_DIR)/include recipe used by
 * include/text_strings.h.in and levels/level_headers.h.in.
 *
 * Carries the event profile: the derived x-only pubkey (from the per-event
 * secret in keys/, or a fixed test vector for host builds), the per-game
 * tag, and the build-epoch created_at constant.
 *
 * Format v2 (spec #52, sub-issue #54, ADR-0001/ADR-0002): pubkey,
 * created_at, and the per-game tag (TAG_1 below) ALL travel in the packed
 * QR payload now (see format_descriptor.h's PUBKEY/CREATED_AT/TAG_LEN+TAG
 * fields) -- build_event()'s pack stage sources them from this generated
 * header so the QR is a self-contained, broadcast-ready event with no
 * out-of-band coordination.
 *
 * `kind` (8064) and the first tag (`["t","ag-lb"]`) are NOT here: they are
 * format-v2-pinned SPEC constants, identical for every build/game, so this
 * generated per-build header does not (and must not) redefine them --
 * carrying a second copy here would risk drifting from the one true
 * definition. See src/pipeline/event_id.h's PIPELINE_EVENT_KIND/
 * PIPELINE_EVENT_TAG_KEY/PIPELINE_EVENT_TAG0_VALUE, the single source.
 *
 * Also carries the raw 32-byte per-event privkey (spec #24, sub-issue #31):
 * capture glue at interact_star_or_key calls build_event(capture, key, ...)
 * with a real key argument, so the ROM needs the same per-event secret
 * gen_event_profile.py already reads (to derive the pubkey above) baked in
 * byte form too -- there is deliberately no second/separate key-injection
 * mechanism. Live signing still happens on-console at grab time (per spec
 * #24's "live-deterministic k=f(d,m)" decision); this is not a precomputed
 * signature, just the key material.
 *
 * Also carries PIPELINE_EVENT_NAME (spec #75, sub-issue #76; promoted to a
 * signed on-wire tag by format v3, spec #109 sub-issue #111): a required
 * event name, rendered locally by the castle HUD corner AND, as of v3,
 * folded into the signed NIP-01 tags array (["n",<name>], event_id.c's
 * pipeline_event_serialize()) and packed onto the wire (format_descriptor.h's
 * NAME_LEN+NAME field, build_event.c's pack call) -- see PIPELINE_EVENT_
 * NAME's own comment below.
 */

#define PIPELINE_EVENT_CREATED_AT @CREATED_AT@u

/* Format v3 (spec #109, sub-issue #111): three signed tags --
 * [["t","ag-lb"],["t",TAG_1_VALUE],["n",EVENT_NAME]]. event_id.c's own
 * compile-time tag-count guard checks this constant against its hardcoded
 * three-tag serialization. */
#define PIPELINE_EVENT_TAG_COUNT 3
/* TAG_1 is the per-game tag: baked per build (from --tag, gen_event_profile.py;
 * defaults to "sm64") AND packed onto the wire (format_descriptor.h's TAG
 * field), so a companion can tell games apart without shared config. The
 * FIRST tag (`ag-lb`) is a format-v2-pinned spec constant, not baked here --
 * see this file's header comment. */
#define PIPELINE_EVENT_TAG_1_VALUE "@GAME_TAG@"
/* Compile-time length of the per-game tag value (excludes the NUL
 * terminator) -- sizeof() of a string literal macro is itself a valid
 * compile-time constant expression, so this is usable anywhere an array
 * bound or other constant-expression context needs it (build_event.h's
 * PIPELINE_BUILT_PAYLOAD_SIZE), with zero risk of drifting from
 * PIPELINE_EVENT_TAG_1_VALUE's actual text. */
#define PIPELINE_EVENT_TAG_1_LEN (sizeof(PIPELINE_EVENT_TAG_1_VALUE) - 1)

/* Event name (spec #75, sub-issue #76; promoted to a signed on-wire tag by
 * format v3, spec #109 sub-issue #111): a REQUIRED, human-readable identity
 * for the event this ROM was built for -- baked per build from --event-name
 * (gen_event_profile.py; no default, the Makefile's PIPELINE_EVENT_NAME
 * fails closed with a $(error) before this script ever runs, mirroring the
 * PIPELINE_PRIVKEY_FILE check). Uppercase-folded (a-z->A-Z), restricted to
 * A-Z/0-9/space, and capped at 17 chars (raised 15->20 by spec #91
 * sub-issue #126, then shrunk back 20->17 by spec #90 sub-issue #139,
 * which SUPERSEDES #126; over-length is a build FATAL, never a silent
 * truncation) -- see gen_event_profile.py's normalize_event_name().
 *
 * ON-WIRE, SIGNED (format v3): this value is rendered locally by the castle
 * HUD corner (render_hud) AND sourced by build_event() -- event_id.c's
 * pipeline_event_serialize() folds it into the signed NIP-01 tags array as
 * ["n",<name>] (so `id` commits to it), and build_event.c's pack call packs
 * it onto the wire (format_descriptor.h's NAME_LEN+NAME field), mirroring
 * PIPELINE_EVENT_TAG_1_VALUE above. Format v2's "display-only, never on the
 * wire" contract (sub-issue #76) is retired by this promotion.
 */
#define PIPELINE_EVENT_NAME "@EVENT_NAME@"
/* Compile-time length of the event name (excludes the NUL terminator),
 * mirroring PIPELINE_EVENT_TAG_1_LEN's own sizeof() convention above --
 * usable anywhere a constant-expression length is needed (e.g. computing
 * the HUD's fixed-pitch right-aligned draw origin at build time). */
#define PIPELINE_EVENT_NAME_LEN (sizeof(PIPELINE_EVENT_NAME) - 1)

/*
 * ADR-0006's airgap transport base URL (spec #115, sub-issue #116;
 * realigned to #101's ratified URL schema by spec #122 sub-issue #123):
 * the build-time constant every emitted QR frame's URL wraps a fragment
 * around -- <PIPELINE_URL_BASE>#<SEQ>/<TOTAL>/<PAYLOAD> (url.h). Mirrors
 * PIPELINE_EVENT_NAME's own provisioning (baked per build from a Makefile
 * variable, --url-base, gen_event_profile.py), but with a dev default
 * (never fail-closed like PIPELINE_EVENT_NAME): a build with no real
 * domain yet still produces a scannable, structurally valid URL, just one
 * pointed at a placeholder host until the real short domain (#101) is
 * purchased and swapped in via PIPELINE_URL_BASE, with no pipeline code
 * change. Emitted VERBATIM -- case is never folded, since URL paths are
 * case-sensitive -- so it rides a QR BYTE segment, not the narrower
 * alphanumeric charset TAG_1_VALUE/EVENT_NAME are restricted to above (see
 * qr_adapter.h's pipeline_qr_encode_two_segment()).
 */
#define PIPELINE_URL_BASE "@URL_BASE@"
/* Compile-time length of the base URL (excludes the NUL terminator),
 * mirroring PIPELINE_EVENT_NAME_LEN's own sizeof() convention above. */
#define PIPELINE_URL_BASE_LEN (sizeof(PIPELINE_URL_BASE) - 1)

/* Derived x-only pubkey (32 bytes), hex and byte-list forms. */
#define PIPELINE_EVENT_PUBKEY_HEX "@PUBKEY_HEX@"
#define PIPELINE_EVENT_PUBKEY_BYTES @PUBKEY_BYTES@

/* Raw 32-byte per-event secp256k1 private key, byte-list form. */
#define PIPELINE_EVENT_PRIVKEY_BYTES @PRIVKEY_BYTES@

#endif /* PIPELINE_EVENT_PROFILE_H */
