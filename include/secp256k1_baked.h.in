#ifndef PIPELINE_SECP256K1_BAKED_H
#define PIPELINE_SECP256K1_BAKED_H

/*
 * GENERATED by tools/gen_secp256k1_baked.py -- DO NOT EDIT (spec #43,
 * sub-issue #46). Rendered from this template into
 * $(BUILD_DIR)/include/secp256k1_baked.h, following the same *.h.in ->
 * $(BUILD_DIR)/include recipe as include/event_profile.h.in/
 * include/text_strings.h.in.
 *
 * Bakes the public point P = d*G (the per-event signing key's public
 * point) as a build-time constant: the per-event private key is fixed at
 * build time (see include/event_profile.h.in), so P is a compile-time
 * constant too, and the runtime signing path (schnorr_adapter.c) no longer
 * needs to compute it via a runtime scalar multiplication + affine-
 * conversion inversion (spec #43, sub-issue #46 -- see
 * pipeline_secp256k1_point_mul_base's/secp256k1.h's own header comments
 * for what this removes from the signing path).
 *
 * PIPELINE_SECP256K1_BAKED_PUBKEY_X_BYTES is redundant with (and must
 * always equal) PIPELINE_EVENT_PUBKEY_BYTES in the separately-generated
 * event_profile.h -- both are P.x. gen_secp256k1_baked.py's own validation
 * (see its module header comment) proves this value is correct THREE ways
 * before ever writing it here: (1) it lies on the curve, (2) a second,
 * structurally independent scalar-multiplication algorithm
 * (scalar_mult_msb_first, MSB-first double-and-add) agrees with it on the
 * FULL point (x and y, catching a wrong parity too, which (1) alone
 * cannot), and (3) it matches nostr_secp256k1.derive_xonly_pubkey (the
 * value event_profile.h's PIPELINE_EVENT_PUBKEY_BYTES is generated from),
 * a cross-file drift guard rather than an independence proof, since that
 * function is the same underlying scalar_mult under another name -- see
 * the generator's own comments for why (2), not (3), is the check that
 * actually proves correctness. The build fails closed on any of the three
 * disagreeing, so a broken generator can never ship a wrong point
 * silently. Baked separately (rather than reused via an #include of
 * event_profile.h) so this header stands alone -- sub-issue #47 (see the
 * PIPELINE_SECP256K1_COMB_* macros below) extends this same generator/
 * template with exactly that second generated table (the fixed-base comb
 * table for k*G), which does not depend on the per-event key at all.
 *
 * PIPELINE_SECP256K1_BAKED_PUBKEY_Y_IS_EVEN is P's y-coordinate parity
 * (BIP-340's has_even_y(P)) -- the only other fact about P the signing path
 * needs (to select d = d' or n - d', BIP-340 keygen step 2). P's actual y
 * value is never needed at runtime and so is deliberately not baked here.
 *
 * PIPELINE_SECP256K1_COMB_* below is sub-issue #47's own extension of this
 * SAME generator/template, exactly as this header's own comment above
 * anticipated: a second generated table, independent of the per-event
 * private key (it depends only on the FIXED public generator G), for the
 * fixed-base comb/window scalar multiplication that replaces
 * secp256k1.c's k*G double-and-add (pipeline_secp256k1_point_mul_base). See
 * tools/gen_secp256k1_baked.py's own header comment (build_comb_table/
 * validate_comb_table) for the algorithm, the size/cache-budget rationale
 * (COMB_D = 6, chosen to use half the VR4300's 8 KB data cache rather than
 * the whole budget or an upstream-sized table that would thrash it), and
 * the three-part validation (on-curve, independent MSB-first re-derivation
 * per table entry, and a seeded differential sweep of the comb algorithm
 * itself against the plain LSB-first reference) that must all pass before
 * this generator ever writes this table out.
 *
 * Unlike PIPELINE_SECP256K1_BAKED_PUBKEY_X_BYTES above (a plain 32-byte
 * big-endian byte string -- BIP-340's own wire format, representation-
 * agnostic), PIPELINE_SECP256K1_COMB_TABLE_INIT is emitted directly in
 * secp256k1.c's PRIVATE internal number representation (little-endian
 * 32-bit limbs, pipeline_secp256k1_num.w[0] = least significant word --
 * see that file's own header comment) so secp256k1.c can use the table as
 * a plain `static const` array with zero runtime byte<->num conversion and
 * zero extra RAM: it is only ever read by secp256k1.c's own
 * point_mul_base_comb(), never by schnorr_adapter.c (which only ever reads
 * the X_BYTES/Y_IS_EVEN pair above), so this one generated header is
 * allowed to carry one value in each of the two representations its two
 * different consumers each need.
 */

#define PIPELINE_SECP256K1_BAKED_PUBKEY_X_BYTES @PUBKEY_X_BYTES@
#define PIPELINE_SECP256K1_BAKED_PUBKEY_Y_IS_EVEN @Y_IS_EVEN@

/* Comb width (bits/digit) and column count (COMB_E = ceil(256/COMB_D)). */
#define PIPELINE_SECP256K1_COMB_D @COMB_D@
#define PIPELINE_SECP256K1_COMB_E @COMB_E@
/* Table row count = 2^COMB_D (index 0 is the unused all-zero-digit slot;
 * point_mul_base_comb() never looks it up -- see its own comment). */
#define PIPELINE_SECP256K1_COMB_TABLE_SIZE @COMB_TABLE_SIZE@
/* sizeof(kCombTable) in bytes -- COMB_TABLE_SIZE * 2 field elements * 32
 * bytes each. secp256k1.c asserts this at COMPILE time (not just here at
 * generation time) against the VR4300's 8 KB data cache budget, via a
 * negative-array-size trick, so a future edit that widens COMB_D without
 * updating this generator's own budget check still fails the build closed
 * rather than silently shipping an oversized table. */
#define PIPELINE_SECP256K1_COMB_TABLE_BYTES @COMB_TABLE_BYTES@
/* The VR4300's data-cache budget kCombTable must fit within -- the SAME
 * constant tools/gen_secp256k1_baked.py's own validate_comb_table() checks
 * PIPELINE_SECP256K1_COMB_TABLE_BYTES against at generation time, emitted
 * here too so secp256k1.c's compile-time budget assertion and the host
 * test tool's own runtime assertion never hardcode a second, possibly-
 * drifting copy of "8192". */
#define PIPELINE_SECP256K1_COMB_CACHE_BUDGET_BYTES @COMB_CACHE_BUDGET_BYTES@
/* C initializer for `static const comb_point kCombTable[PIPELINE_SECP256K1_COMB_TABLE_SIZE]`
 * (comb_point == { pipeline_secp256k1_num x, y; }, secp256k1.c-private). */
#define PIPELINE_SECP256K1_COMB_TABLE_INIT @COMB_TABLE_INIT@

#endif /* PIPELINE_SECP256K1_BAKED_H */
