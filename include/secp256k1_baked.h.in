#ifndef PIPELINE_SECP256K1_BAKED_H
#define PIPELINE_SECP256K1_BAKED_H

/*
 * GENERATED by tools/gen_secp256k1_baked.py -- DO NOT EDIT (spec #43,
 * sub-issue #46). Rendered from this template into
 * $(BUILD_DIR)/include/secp256k1_baked.h, following the same *.h.in ->
 * $(BUILD_DIR)/include recipe as include/event_profile.h.in/
 * include/text_strings.h.in.
 *
 * Bakes the public point P = d*G (the per-event signing key's public
 * point) as a build-time constant: the per-event private key is fixed at
 * build time (see include/event_profile.h.in), so P is a compile-time
 * constant too, and the runtime signing path (schnorr_adapter.c) no longer
 * needs to compute it via a runtime scalar multiplication + affine-
 * conversion inversion (spec #43, sub-issue #46 -- see
 * pipeline_secp256k1_point_mul_base's/secp256k1.h's own header comments
 * for what this removes from the signing path).
 *
 * PIPELINE_SECP256K1_BAKED_PUBKEY_X_BYTES is redundant with (and must
 * always equal) PIPELINE_EVENT_PUBKEY_BYTES in the separately-generated
 * event_profile.h -- both are P.x. gen_secp256k1_baked.py's own validation
 * (see its module header comment) proves this value is correct THREE ways
 * before ever writing it here: (1) it lies on the curve, (2) a second,
 * structurally independent scalar-multiplication algorithm
 * (scalar_mult_msb_first, MSB-first double-and-add) agrees with it on the
 * FULL point (x and y, catching a wrong parity too, which (1) alone
 * cannot), and (3) it matches nostr_secp256k1.derive_xonly_pubkey (the
 * value event_profile.h's PIPELINE_EVENT_PUBKEY_BYTES is generated from),
 * a cross-file drift guard rather than an independence proof, since that
 * function is the same underlying scalar_mult under another name -- see
 * the generator's own comments for why (2), not (3), is the check that
 * actually proves correctness. The build fails closed on any of the three
 * disagreeing, so a broken generator can never ship a wrong point
 * silently. Baked separately (rather than reused via an #include of
 * event_profile.h) so this header stands alone -- relevant for sub-issue
 * #47, which is expected to extend this same generator/template with a
 * second generated table (the fixed-base comb table for k*G) that does
 * not depend on the per-event key at all.
 *
 * PIPELINE_SECP256K1_BAKED_PUBKEY_Y_IS_EVEN is P's y-coordinate parity
 * (BIP-340's has_even_y(P)) -- the only other fact about P the signing path
 * needs (to select d = d' or n - d', BIP-340 keygen step 2). P's actual y
 * value is never needed at runtime and so is deliberately not baked here.
 */

#define PIPELINE_SECP256K1_BAKED_PUBKEY_X_BYTES @PUBKEY_X_BYTES@
#define PIPELINE_SECP256K1_BAKED_PUBKEY_Y_IS_EVEN @Y_IS_EVEN@

#endif /* PIPELINE_SECP256K1_BAKED_H */
